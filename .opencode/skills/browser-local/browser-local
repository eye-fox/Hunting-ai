def _scan_global_flags():
    vals = {
        'cdp_url': None, 'session': 'default',
        'json': False, 'human': False,
    }
    filtered = [sys.argv[0]]
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        consumed = False
        if arg.startswith('--') and '=' in arg:
            key, val = arg.split('=', 1)
            if key == '--cdp-url': vals['cdp_url'] = val; consumed = True
            elif key == '--session': vals['session'] = val; consumed = True
        if not consumed:
            if arg == '--cdp-url' and i+1 < len(sys.argv):
                vals['cdp_url'] = sys.argv[i+1]; consumed = True; i += 1
            elif arg == '--session' and i+1 < len(sys.argv):
                vals['session'] = sys.argv[i+1]; consumed = True; i += 1
            elif arg == '--json': vals['json'] = True; consumed = True
            elif arg == '--human': vals['human'] = True; consumed = True
            elif arg == '--headed': consumed = True  # ignore, always headless
        if not consumed:
            filtered.append(arg)
        i += 1
    return vals, filtered

