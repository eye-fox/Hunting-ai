# --- History helpers ---

def _hist_load():
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE) as f:
                return json.load(f)
        except:
            pass
    return []

def _hist_save(entries):
    with open(HISTORY_FILE, "w") as f:
        json.dump(entries, f, indent=2)

def _hist_append(entries):
    h = _hist_load()
    h.extend(entries)
    _hist_save(h)

def _scope_get():
    if os.path.exists(SCOPE_FILE):
        try:
            with open(SCOPE_FILE) as f:
                return json.load(f)
        except:
            pass
    return {"enabled": False, "includes": [], "excludes": []}

def _scope_match(url):
    s = _scope_get()
    if not s.get("enabled"):
        return True
    inc = s.get("includes", [])
    exc = s.get("excludes", [])
    for p in exc:
        if p and p in url:
            return False
    if not inc:
        return True
    for p in inc:
        if p and p in url:
            return True
    return False

def _match_replace_apply(hdrs, body):
    if not os.path.exists(MATCH_REPLACE_FILE):
        return hdrs, body
    try:
        with open(MATCH_REPLACE_FILE) as f:
            rules = json.load(f)
    except:
        return hdrs, body
    for r in rules:
        if not r.get("enabled", True):
            continue
        target = r.get("target", "request")
        where = r.get("where", "body")
        match = r.get("match", "")
        repl = r.get("replace", "")
        try:
            if target == "request" and where == "header":
                for k in list(hdrs.keys()):
                    if re.search(match, k, re.I):
                        new_k = re.sub(match, repl, k)
                        if new_k != k:
                            hdrs[new_k] = hdrs.pop(k)
                    if re.search(match, str(hdrs.get(k, '')), re.I):
                        hdrs[k] = re.sub(match, repl, str(hdrs[k]))
            elif target == "request" and where == "body" and body:
                body = re.sub(match, repl, body)
        except:
            pass
    return hdrs, body

def _build_sitemap():
    history = _hist_load()
    tree = {}
    for entry in history:
        url = entry.get("url", "")
        if not url:
            continue
        try:
            parsed = urllib.parse.urlparse(url)
            host = parsed.netloc or parsed.path
            path = parsed.path or "/"
            qs = parsed.query or ""
        except:
            host = url
            path = "/"
            qs = ""
        if host not in tree:
            tree[host] = {"paths": {}, "total": 0}
        tree[host]["total"] += 1
        if path not in tree[host]["paths"]:
            tree[host]["paths"][path] = {"methods": {}, "count": 0, "params": set()}
        tree[host]["paths"][path]["count"] += 1
        m = entry.get("method", "GET")
        if m not in tree[host]["paths"][path]["methods"]:
            tree[host]["paths"][path]["methods"][m] = 0
        tree[host]["paths"][path]["methods"][m] += 1
        if qs:
            tree[host]["paths"][path]["params"].add(qs)
    # Convert sets to lists for JSON
    for host in tree:
        for path in tree[host]["paths"]:
            tree[host]["paths"][path]["params"] = list(tree[host]["paths"][path]["params"])
    return tree

def _drain_fetch_events(ws):
    if not _CDP_FETCH_ACTIVE:
        return
    global _CDP_ORIG_TIMEOUT
    try:
        _CDP_ORIG_TIMEOUT = ws.gettimeout()
        ws.settimeout(0)
        while True:
            raw = ws.recv()
            data = json.loads(raw)
            if data.get("method") == "Fetch.requestPaused":
                _handle_fetch_request_paused(data["params"])
            elif data.get("method") == "Fetch.authRequired":
                cdp(ws, "Fetch.continueWithAuth", {
                    "requestId": data["params"]["requestId"],
                    "authChallengeResponse": {"response": "Default"}
                }, session_id=None)
    except (Exception, SystemExit, KeyboardInterrupt):
        pass
    finally:
        try:
            ws.settimeout(_CDP_ORIG_TIMEOUT)
        except:
            pass

def cdp(ws, method, params=None, session_id=None):
    if params is None: params = {}
    mid = int(time.time() * 1e6) % 2**31
    msg = {"id": mid, "method": method, "params": params}
    if session_id: msg["sessionId"] = session_id
    ws.send(json.dumps(msg))
    while True:
        try:
            raw = ws.recv()
        except:
            return None
        data = json.loads(raw)
        if data.get("method") == "Fetch.requestPaused" and _CDP_FETCH_ACTIVE:
            _handle_fetch_request_paused(data["params"])
            continue
        if data.get("id") == mid:
            if "error" in data: raise Exception(json.dumps(data["error"]))
            return data.get("result")

def _drain_cdp_events(ws):
    events = []
    global _CDP_ORIG_TIMEOUT
    try:
        _CDP_ORIG_TIMEOUT = ws.gettimeout()
        ws.settimeout(0)
        while True:
            raw = ws.recv()
            data = json.loads(raw)
            if data.get("method") == "Fetch.requestPaused" and _CDP_FETCH_ACTIVE:
                _handle_fetch_request_paused(data["params"])
            else:
                events.append(data)
    except:
        pass
    finally:
        try:
            ws.settimeout(_CDP_ORIG_TIMEOUT)
        except:
            pass
    return events

def js_eval(ws, ses, expr):
    r = cdp(ws, "Runtime.evaluate", {"expression": expr,"returnByValue": True,"awaitPromise": True}, session_id=ses)
    if r is None: return {"error": "cdp returned None (timeout/disconnect)"}
    if "exceptionDetails" in r: return {"error": r["exceptionDetails"].get("text",""),"detail": r.get("result",{}).get("description","")}
    return r["result"].get("value")

