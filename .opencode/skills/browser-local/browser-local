def _handle_fetch_request_paused(params):
    global _CDP_PAUSED_REQUESTS, _CDP_NEXT_ID, _CDP_FETCH_PATTERN
    request_id = params["requestId"]
    req = params["request"]
    url = req.get("url", "")
    method = req.get("method", "GET")
    headers = req.get("headers", {})
    post_data = None
    if "postData" in params:
        post_data = params["postData"]
    elif "requestPostData" in params:
        post_data = params["requestPostData"].get("postData", None)
    if _CDP_FETCH_PATTERN and not re.search(_CDP_FETCH_PATTERN, url):
        return False
    rid = _CDP_NEXT_ID
    _CDP_NEXT_ID += 1
    _CDP_PAUSED_REQUESTS.append({
        "id": rid,
        "requestId": request_id,
        "url": url,
        "method": method,
        "headers": headers,
        "body": post_data,
        "type": "fetch-cdp",
        "modifiedBody": None,
        "modifiedMethod": None,
        "modifiedHeaders": None,
        "fulfillWith": None
    })
    return True

def _intercept(ws, ses, action, args):
