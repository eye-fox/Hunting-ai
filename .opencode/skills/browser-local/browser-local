        _CDP_FETCH_PATTERN = pat
        js_eval(ws, ses, f"window.__bl_intercept_pattern={json.dumps(pat)}")
        jsr = js_eval(ws, ses, INTERCEPT_JS)
        js_ok = not (isinstance(jsr, dict) and jsr.get("error"))
        if _INTERCEPT_SCRIPT_IDENTIFIER is not None:
            try:
                cdp(ws, "Page.removeScriptToEvaluateOnNewDocument", {"identifier": _INTERCEPT_SCRIPT_IDENTIFIER}, session_id=ses)
            except:
                pass
            _INTERCEPT_SCRIPT_IDENTIFIER = None
        on_doc_script = f"window.__bl_intercept_pattern={json.dumps(pat)};\n" + INTERCEPT_JS
        try:
            r = cdp(ws, "Page.addScriptToEvaluateOnNewDocument", {"source": on_doc_script}, session_id=ses)
            if r and "identifier" in r:
                _INTERCEPT_SCRIPT_IDENTIFIER = r["identifier"]
        except:
            pass
        try:
            cdp(ws, "Fetch.enable")
            _CDP_FETCH_ACTIVE = True
            _CDP_PAUSED_REQUESTS = []
            cdp_ok = True
        except Exception as e:
            cdp_ok = False
        try:
            with open(INTERCEPT_STATE_FILE, "w") as f:
                json.dump({"pattern": pat, "active": True, "ts": time.time()}, f)
