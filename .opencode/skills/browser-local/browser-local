# ====== BUILT-IN HTTP CLIENT FOR REPEATER ======

def _http_send(method, url, headers=None, body=None, timeout=15):
    """Send raw HTTP request and return response."""
    try:
        parsed = urllib.parse.urlparse(url)
        scheme = parsed.scheme or "https"
        host = parsed.netloc or parsed.hostname
        port = parsed.port
        path = parsed.path or "/"
        if parsed.query:
            path += "?" + parsed.query

        if not host:
            return {"error": "invalid url", "url": url}

        if scheme == "https":
            conn = http.client.HTTPSConnection(host, port=port or 443, timeout=timeout)
        else:
            conn = http.client.HTTPConnection(host, port=port or 80, timeout=timeout)

        if headers is None:
            headers = {}
        if "Host" not in headers and "host" not in {k.lower() for k in headers}:
            headers["Host"] = host

        conn.request(method, path, body=body, headers=headers)
        resp = conn.getresponse()
        resp_body = resp.read().decode("utf-8", errors="replace")
        resp_headers = dict(resp.getheaders())
        conn.close()
        return {
            "statusCode": resp.status,
            "statusText": resp.reason,
            "headers": resp_headers,
            "body": resp_body[:500000],
            "url": url,
            "method": method
        }
    except Exception as e:
        return {"error": str(e)}

# ====== COLLABORATOR (interactsh) ======

_COLLAB_PROC = None
_COLLAB_THREAD = None
_COLLAB_QUEUE = queue.Queue()

def _collab_poll_thread(server, poll_interval):
    """Background thread that reads interactsh-client output and queues interactions."""
    global _COLLAB_PROC
    try:
        import select
        while _COLLAB_PROC and _COLLAB_PROC.poll() is None:
            # Read lines from stderr (interactsh outputs to stderr when json is not used)
            if _COLLAB_PROC.stderr:
                try:
                    line = _COLLAB_PROC.stderr.readline()
                    if line:
                        _COLLAB_QUEUE.put({"type": "log", "line": line.strip()})
                except:
                    pass
            if _COLLAB_PROC.stdout:
                try:
                    line = _COLLAB_PROC.stdout.readline()
                    if line:
                        data = line.strip()
                        try:
                            parsed = json.loads(data)
                            _COLLAB_QUEUE.put({"type": "interaction", "data": parsed})
                        except:
                            _COLLAB_QUEUE.put({"type": "raw", "line": data})
                except:
                    pass
            time.sleep(0.1)
    except:
        pass
    finally:
        _COLLAB_QUEUE.put({"type": "stopped"})

def cmd_start(args):
    if os.path.exists(DATA_DIR):
        for _ in range(10):
            try: shutil.rmtree(DATA_DIR); break
            except: time.sleep(0.5)
    os.makedirs(DATA_DIR, exist_ok=True)
    port = args.port or 0
    w = args.width or 0
    h = args.height or 0
    if not w or not h:
        sz = random.choice(_COMMON_SIZES)
        if not w: w = sz[0]
        if not h: h = sz[1]
    locale = args.locale or 'en-US'
    ua = f'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/{BVER}.0.0.0 Safari/537.36'
    cmd = [
        BROWSER, f"--remote-debugging-port={port}",
        "--headless=new",
        "--no-sandbox",
        f"--window-size={w},{h}",
        f"--lang={locale[:5]}",
        "--disable-blink-features=AutomationControlled",
        "--disable-sync","--disable-extensions",
        "--disable-background-networking","--disable-default-apps",
        "--disable-translate","--mute-audio","--no-first-run",
        "--disable-features=ChromeWhatsNewUI,TranslateUI",
        "--remote-allow-origins=*",
        f"--ozone-override-screen-size={w},{h}",
        f'--user-agent={ua}',
        f"--user-data-dir={DATA_DIR}",
        "about:blank"
    ]
    if args.proxy_server:
        cmd.insert(4, f"--proxy-server={args.proxy_server}")
    if args.tz:
        cmd.insert(4, f"--timezone={args.tz}")
    if args.profile:
        pdir = os.path.expanduser(f"~/.config/chromium/{args.profile}")
        cmd[cmd.index(f"--user-data-dir={DATA_DIR}")] = f"--user-data-dir={pdir}"
    cmd = [c for c in cmd if c]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, start_new_session=True)
    port = None; t0 = time.time()
    while time.time() - t0 < 10:
        line = proc.stderr.readline().decode("utf-8",errors="replace")
        m = re.search(r"ws://[^\s]+:(\d+)",line)
        if m: port = int(m.group(1)); break
    if not port: print("ERROR: cannot find CDP port",file=sys.stderr); proc.kill(); sys.exit(1)
    ws_url = json.loads(urllib.request.urlopen(f"http://127.0.0.1:{port}/json/version").read())["webSocketDebuggerUrl"]
    with open(PID_FILE,"w") as f: json.dump({"pid":proc.pid,"ppid":os.getpid(),"cdp_url":ws_url,"port":port,"w":w,"h":h,"tz":args.tz,"locale":locale},f)
    if args.json: print(json.dumps({"cdp_url":ws_url,"pid":proc.pid,"port":port}))
    else: print(ws_url)
    print(f"[browser-local] PID={proc.pid} port={port} headless",file=sys.stderr); sys.stdout.flush()
    signal.signal(signal.SIGTERM, lambda s,f: sys.exit(0))
    try:
        while True: time.sleep(60)
    except KeyboardInterrupt: os.kill(proc.pid,signal.SIGTERM); proc.wait(); sys.exit(0)

